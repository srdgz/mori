---
interface Props { from: string; to: string; accent?: string }
const { from, to, accent = "var(--color-sage)" } = Astro.props;
---
<div class="relative -mb-px block h-[clamp(56px,8vw,120px)] overflow-hidden" style={`background:${from}`} aria-hidden="true">
  <svg class="absolute bottom-0 left-0 h-full w-[200%] opacity-60 [animation:wave_26s_linear_infinite_reverse]" style={`color:${accent}`} viewBox="0 0 2880 120" preserveAspectRatio="none">
    <path fill="currentColor" d="M0 70C240 20 480 20 720 70s480 50 720 0 480-50 720 0 480 50 720 0V120H0Z" />
  </svg>
  <svg class="absolute bottom-0 left-0 h-full w-[200%] [animation:wave_17s_linear_infinite]" style={`color:${to}`} viewBox="0 0 2880 120" preserveAspectRatio="none">
    <path fill="currentColor" d="M0 80C240 40 480 120 720 80s480-80 720 0 480 40 720 0 480-80 720 0V120H0Z" />
  </svg>
</div>
