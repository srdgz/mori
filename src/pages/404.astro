---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Mark from "../components/Mark.astro";
import { href } from "../i18n/ui";
---
<Base lang="es" page="home" title="404 — MŌRI Matcha Bar & Culture" description="Esta página no existe.">
  <section class="grid min-h-svh place-items-center pt-[var(--nav-h)] text-center">
    <div class="wrap">
      <span data-draw class="mx-auto mb-8 block size-20 text-forest"><Mark class="size-full" /></span>
      <h1 class="display text-[clamp(5rem,22vw,16rem)] text-forest">404</h1>
      <p class="lede mx-auto mt-4">Esta página se ha ido a por un matcha. <span lang="en">This page popped out for a matcha.</span></p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a class="btn" href={href("es", "home")}>Volver al inicio<Icon name="arrow" /></a>
        <a class="btn btn--ghost" href={href("en", "home")} lang="en">Back to home</a>
      </div>
    </div>
  </section>
</Base>
