---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import Wave from "../components/Wave.astro";
import { drinks, formatPrice } from "../data/menu";
import { href, type Lang } from "../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;

const c = {
  es: {
    title: "La carta — MŌRI Matcha Bar & Culture",
    description: "La carta de MŌRI: Classic, Strawberry, Vanilla, Coconut, Dirty e Iced Mango Matcha, más Seasonal Drops, Pure Matcha y Matcha Specials.",
    eyebrow: "Matcha de autor",
    heroLines: ["La", "carta"],
    lede: "Una carta corta, visual y con nombres propios. Seis bebidas que se piden solas y tres colecciones para cuando te apetece algo distinto.",
    collH: "La colección",
    cup: "Vaso",
    size: "Tamaño regular · 350 ml",
    moreK: "Más colecciones",
    moreH: "Para todos los moods.",
    colls: [
      ["Seasonal Drops", "Edición limitada", "Bebidas de temporada que llegan y se van: yuzu en invierno, melocotón en verano, calabaza especiada en otoño."],
      ["Pure Matcha", "Tradicional", "Matcha ceremonial solo con agua, batido al momento. Usucha ligero o koicha intenso para los puristas."],
      ["Matcha Specials", "Exclusivos MŌRI", "Combinaciones que solo vas a encontrar aquí: tónica, cold foam de sésamo negro, hojicha… Pregunta en barra."],
    ],
    extrasK: "Personaliza",
    extras: [
      ["Bebidas vegetales", [["Avena", "+0,40 €"], ["Almendra", "+0,40 €"], ["Coco", "+0,40 €"], ["Soja", "+0,40 €"]]],
      ["Extras", [["Shot extra de matcha", "+1,00 €"], ["Espuma fría (cold foam)", "+0,80 €"], ["Sirope de vainilla casero", "+0,50 €"], ["Sin azúcar", "0,00 €"]]],
      ["Tamaños", [["Normal · 350 ml", "Base"], ["Grande · 470 ml", "+0,90 €"], ["Taza para tomar aquí", "Base"], ["Trae tu vaso", "−0,30 €"]]],
    ],
    note: "La carta es una propuesta inicial de producto, no una selección definitiva de ingredientes o recetas. Si tienes alguna alergia o intolerancia, pregúntanos.",
    ctaH: "¿Ya sabes cuál vas a pedir?",
    ctaP: "Te esperamos en Malasaña todos los días de la semana.",
    cta: "Cómo llegar",
  },
  en: {
    title: "The Menu — MŌRI Matcha Bar",
    description: "The MŌRI menu: Classic, Strawberry, Vanilla, Coconut, Dirty and Iced Mango Matcha, plus Seasonal Drops, Pure Matcha and Matcha Specials.",
    eyebrow: "Signature matcha",
    heroLines: ["The", "Menu"],
    lede: "A short, visual menu with names of its own. Six drinks that sell themselves and three collections for when you fancy something different.",
    collH: "The Matcha Collection",
    cup: "Cup",
    size: "Regular 350 ml",
    moreK: "More collections",
    moreH: "For every mood.",
    colls: [
      ["Seasonal Drops", "Limited edition", "Seasonal drinks that come and go: yuzu in winter, peach in summer, spiced pumpkin in autumn."],
      ["Pure Matcha", "Traditional", "Ceremonial matcha with water only, whisked to order. Light usucha or intense koicha for the purists."],
      ["Matcha Specials", "Only at MŌRI", "Combinations you'll only find here: tonic, black sesame cold foam, hojicha… Ask at the bar."],
    ],
    extrasK: "Make it yours",
    extras: [
      ["Plant milks", [["Oat", "+€0.40"], ["Almond", "+€0.40"], ["Coconut", "+€0.40"], ["Soy", "+€0.40"]]],
      ["Extras", [["Extra matcha shot", "+€1.00"], ["Cold foam", "+€0.80"], ["House vanilla syrup", "+€0.50"], ["No sugar", "€0.00"]]],
      ["Sizes", [["Regular · 350 ml", "Base"], ["Large · 470 ml", "+€0.90"], ["Mug to stay", "Base"], ["Bring your own cup", "−€0.30"]]],
    ],
    note: "This menu is an initial product proposal, not a final selection of ingredients or recipes. If you have any allergy or intolerance, just ask us.",
    ctaH: "Already know what you're ordering?",
    ctaP: "We're waiting for you in Malasaña, seven days a week.",
    cta: "Get directions",
  },
}[lang];

const price = (p: string) => formatPrice(p, lang);
---
<Base lang={lang} page="menu" title={c.title} description={c.description}>
  <PageHero index="02" eyebrow={c.eyebrow} lines={c.heroLines as [string, string]} lede={c.lede} />

  <section class="pb-[clamp(80px,12vw,170px)]" aria-labelledby="coll-h">
    <div class="wrap">
      <h2 id="coll-h" class="sr-only">{c.collH}</h2>
      <ol class="border-t border-line">
        {drinks.map((d, i) => (
          <li id={d.id} class="menu-item group scroll-mt-[calc(var(--nav-h)+24px)]" data-anim="fade">
            <span class="menu-item__no font-display font-medium text-sage" aria-hidden="true">0{i + 1}</span>
            <div class="menu-item__media media media--zoom aspect-[4/5] rounded-[14px]">
              <Image src={d.image} widths={[240, 440]} sizes="(min-width: 54rem) 220px, 110px" alt={d.alt[lang]} loading={i < 2 ? "eager" : "lazy"} />
            </div>
            <div class="menu-item__body">
              <h3 class="font-display text-[clamp(1.6rem,3.4vw,3rem)] leading-none font-semibold tracking-tight text-forest">{d.name}</h3>
              <p class="mt-2.5 mb-3.5 max-w-[48ch] text-ink-soft">{d.long[lang]}</p>
              <ul class="flex flex-wrap gap-2">
                <li class="tag"><i class="chip size-3" style={`--c:${d.cup}`}></i>{d.cupName[lang]}</li>
                {d.tags.map((tg) => <li class="tag">{tg[lang]}</li>)}
              </ul>
            </div>
            <p class="menu-item__price font-display text-[clamp(1.3rem,2vw,1.8rem)] font-semibold whitespace-nowrap text-forest">
              {price(d.price)}<small class="block font-sans text-xs font-normal text-ink-soft md:text-right">{c.size}</small>
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Wave from="var(--color-paper)" to="var(--color-forest)" />

  <section class="on-dark bg-forest pt-[clamp(40px,6vw,80px)] pb-[clamp(80px,12vw,170px)] text-cream" aria-labelledby="more-h">
    <div class="wrap">
      <span class="eyebrow" data-anim="fade">{c.moreK}</span>
      <h2 id="more-h" class="h-lg mt-4 mb-[clamp(36px,5vw,64px)]" data-anim="lines">{c.moreH}</h2>
      <ul class="grid gap-[clamp(14px,2vw,24px)] md:grid-cols-3">
        {c.colls.map(([name, kicker, text]) => (
          <li class="coll" data-anim="fade">
            <span class="text-xs font-semibold tracking-[.18em] text-matcha uppercase">{kicker}</span>
            <div>
              <h3 class="font-display text-[clamp(1.8rem,2.6vw,2.4rem)] leading-none font-semibold tracking-tight">{name}</h3>
              <p class="mt-3 text-sage">{text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Wave from="var(--color-forest)" to="var(--color-cream)" />

  <section class="section bg-cream pt-[clamp(48px,7vw,96px)]" aria-labelledby="extras-h">
    <div class="wrap">
      <h2 id="extras-h" class="h-lg mb-[clamp(32px,5vw,56px)] text-forest" data-anim="lines">{c.extrasK}</h2>
      <div class="grid gap-[clamp(24px,3vw,48px)] md:grid-cols-3">
        {c.extras.map(([group, rows]) => (
          <div data-anim="fade">
            <h3 class="mb-3.5 text-xl font-semibold text-forest">{group as string}</h3>
            <ul class="border-t border-line">
              {(rows as string[][]).map(([label, val]) => (
                <li class="flex justify-between gap-3 border-b border-line py-3 text-ink-soft"><span>{label}</span><span class="font-medium whitespace-nowrap text-forest">{val}</span></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="mt-10 flex max-w-[70ch] items-start gap-2.5 text-sm text-ink-soft" data-anim="fade"><Icon name="leaf" size={18} class="mt-0.5 flex-none text-forest" />{c.note}</p>
    </div>
  </section>

  <section class="section text-center">
    <div class="wrap">
      <h2 class="h-xl mx-auto max-w-[16ch] text-forest" data-anim="lines">{c.ctaH}</h2>
      <p class="lede mx-auto mt-5" data-anim="fade">{c.ctaP}</p>
      <a class="btn mt-9" href={href(lang, "findus")} data-magnetic data-anim="fade">{c.cta}<Icon name="arrow" /></a>
    </div>
  </section>
</Base>

<style>
  .menu-item {
    display: grid;
    grid-template-columns: 110px 1fr;
    grid-template-areas: "media body" "media price";
    column-gap: 18px; row-gap: 10px;
    align-items: start;
    padding-block: clamp(20px, 2.6vw, 32px);
    border-bottom: 1px solid var(--color-line);
  }
  .menu-item__no { display: none; }
  .menu-item__media { grid-area: media; }
  .menu-item__body { grid-area: body; }
  .menu-item__price { grid-area: price; align-self: end; }
  @media (min-width: 54rem) {
    .menu-item { grid-template-columns: 70px minmax(150px, 220px) 1fr auto; grid-template-areas: "no media body price"; gap: clamp(16px, 3vw, 48px); align-items: center; }
    .menu-item__no { display: block; grid-area: no; }
    .menu-item__price { align-self: center; }
  }
  .tag { display: inline-flex; align-items: center; gap: 7px; font-size: .75rem; font-weight: 500; padding: 5px 11px; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--color-line); }
  .coll {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: 300px; display: flex; flex-direction: column; justify-content: space-between; gap: 24px;
    padding: clamp(24px, 3vw, 38px); border-radius: var(--radius-card);
    background: var(--color-forest-deep); box-shadow: inset 0 0 0 1px var(--color-line-light);
    transition: translate .6s var(--ease-out-expo);
  }
  .coll::after { content: ""; position: absolute; z-index: -1; width: 260px; height: 260px; right: -90px; top: -90px; border-radius: 50%; background: var(--color-matcha); opacity: .12; transition: transform .8s var(--ease-out-expo), opacity .6s; }
  .coll:hover { translate: 0 -6px; }
  .coll:hover::after { transform: scale(1.6); opacity: .2; }
</style>
