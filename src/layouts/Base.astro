---
import "../styles/global.css";
import Header from "../components/Header.astro";
import LogoSprite from "../components/LogoSprite.astro";
import Footer from "../components/Footer.astro";
import { href, useT, brand, type Lang, type RouteKey } from "../i18n/ui";
import heroImg from "../assets/photos/mori-hero.png";
import { getImage } from "astro:assets";
import displayFont from "@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url";
import bodyFont from "@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url";

interface Props {
  lang: Lang;
  page: RouteKey;
  title: string;
  description: string;
}
const { lang, page, title, description } = Astro.props;
const t = useT(lang);
const site = Astro.site ?? new URL("https://mori-matcha-bar.vercel.app");
const canonical = new URL(href(lang, page), site).href;
const altEs = new URL(href("es", page), site).href;
const altEn = new URL(href("en", page), site).href;
const og = await getImage({ src: heroImg, width: 1200, format: "jpg" });
const ogUrl = new URL(og.src, site).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CafeOrCoffeeShop",
  name: "MŌRI Matcha Bar & Culture",
  url: site.href,
  servesCuisine: "Matcha",
  priceRange: "€",
  address: { "@type": "PostalAddress", streetAddress: brand.address, postalCode: "28004", addressLocality: "Madrid", addressCountry: "ES" },
  openingHoursSpecification: [
    { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], opens: brand.hours.weekday[0], closes: brand.hours.weekday[1] },
    { "@type": "OpeningHoursSpecification", dayOfWeek: ["Saturday", "Sunday"], opens: brand.hours.weekend[0], closes: brand.hours.weekend[1] },
  ],
};
---
<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#183D2B" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={altEs} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altEs} />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MŌRI Matcha Bar & Culture" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_GB"} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.replace("no-js", "js");</script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body data-page={page}>
    <LogoSprite />
    <a href="#main" class="fixed top-[-80px] left-3 z-[100] rounded-full bg-forest px-4 py-2.5 text-cream transition-[top] focus:top-3">{t("skip")}</a>
    <Header lang={lang} page={page} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import "../scripts/ui";
      import "../scripts/motion";
    </script>
  </body>
</html>
