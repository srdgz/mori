---
import Mark from "./Mark.astro";
import Wordmark from "./Wordmark.astro";
import { routes, href, useT, brand, type Lang, type RouteKey } from "../i18n/ui";
interface Props { lang: Lang; page: RouteKey }
const { lang, page } = Astro.props;
const t = useT(lang);
const nav = routes.filter((r) => r.key !== "home");
---
<header class="site-header fixed inset-x-0 top-0 z-50 h-[var(--nav-h)]" data-header>
  <div class="wrap flex h-full items-center justify-between gap-6">
    <a href={href(lang, "home")} class="brand relative z-10 inline-flex items-center gap-3 text-forest">
      <Mark class="size-9" />
      <Wordmark class="h-5 w-auto" />
      <span class="sr-only">{t("home")}</span>
    </a>
    <div class="flex items-center gap-4 lg:gap-8">
      <nav aria-label={t("navLabel")} class="hidden lg:block">
        <ul class="flex gap-7">
          {nav.map((r) => (
            <li>
              <a href={href(lang, r.key)} class="nav-link relative py-1.5 text-[.92rem] font-medium" aria-current={page === r.key ? "page" : undefined}>{r.label[lang]}</a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="lang relative z-10 inline-flex rounded-full p-[3px] text-xs font-semibold tracking-[.08em]" role="group" aria-label={t("langLabel")}>
        <a href={href("es", page)} hreflang="es" lang="es" class="rounded-full px-2.5 py-1.5" aria-current={lang === "es" ? "true" : undefined}><span class="sr-only">Español</span><span aria-hidden="true">ES</span></a>
        <a href={href("en", page)} hreflang="en" lang="en" class="rounded-full px-2.5 py-1.5" aria-current={lang === "en" ? "true" : undefined}><span class="sr-only">English</span><span aria-hidden="true">EN</span></a>
      </div>
      <button type="button" class="burger relative z-10 size-11 rounded-full bg-forest lg:hidden" aria-expanded="false" aria-controls="mobile-menu" data-burger data-open-label={t("menuOpen")} data-close-label={t("menuClose")}>
        <span class="sr-only" data-burger-label>{t("menuOpen")}</span>
        <span class="burger__bar top-[18px]" aria-hidden="true"></span>
        <span class="burger__bar top-[25px]" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu fixed inset-0 z-40 flex flex-col justify-between bg-forest px-[var(--gutter)] pt-[calc(var(--nav-h)+32px)] pb-8 text-cream lg:hidden" data-mobile-menu hidden>
  <nav aria-label={t("navLabel")}>
    <ol class="m-0 list-none p-0">
      {routes.map((r, i) => (
        <li class="border-b border-line-light">
          <a href={href(lang, r.key)} class="flex items-baseline justify-between gap-3 py-2.5 font-display text-[clamp(2rem,9vw,3.2rem)] font-semibold tracking-tight" aria-current={page === r.key ? "page" : undefined}>
            {r.label[lang]}<span class="font-sans text-sm tracking-widest text-matcha" aria-hidden="true">0{i + 1}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
  <div class="flex flex-col gap-2 text-sm text-sage xs:flex-row xs:justify-between">
    <span>{brand.address} · Madrid</span>
    <span>{brand.instagram}</span>
  </div>
</div>

<style>
  .site-header { transition: background-color .5s var(--ease-out-expo), box-shadow .5s var(--ease-out-expo), translate .5s var(--ease-out-expo); }
  .site-header.is-scrolled { background: rgb(243 239 231 / 0.94); box-shadow: 0 1px 0 var(--color-line); }
  @supports (backdrop-filter: blur(12px)) {
    .site-header.is-scrolled { background: rgb(243 239 231 / 0.78); backdrop-filter: blur(14px) saturate(140%); }
  }
  .site-header.is-hidden { translate: 0 -100%; }
  .nav-link::after {
    content: "";
    position: absolute; inset-inline: 0; bottom: 0; height: 1.5px;
    background: var(--color-forest);
    transform: scaleX(0); transform-origin: right;
    transition: transform .45s var(--ease-out-expo);
  }
  .nav-link:hover::after, .nav-link[aria-current="page"]::after { transform: scaleX(1); transform-origin: left; }
  .nav-link[aria-current="page"] { color: var(--color-forest); }
  .lang { box-shadow: inset 0 0 0 1px var(--color-line); }
  .lang a { color: var(--color-ink-soft); transition: background-color .3s, color .3s; }
  .lang a[aria-current="true"] { background: var(--color-forest); color: var(--color-cream); }
  .burger__bar { position: absolute; left: 13px; right: 13px; height: 1.5px; background: var(--color-cream); transition: transform .4s var(--ease-out-expo), top .4s var(--ease-out-expo); }
  :global(.menu-open) .burger { background: var(--color-matcha); }
  :global(.menu-open) .burger__bar { background: var(--color-forest); top: 21.5px; }
  :global(.menu-open) .burger__bar:first-of-type { transform: rotate(45deg); }
  :global(.menu-open) .burger__bar:last-of-type { transform: rotate(-45deg); }
  :global(.menu-open) .brand { color: var(--color-cream); }
  :global(.menu-open) .lang { box-shadow: inset 0 0 0 1px var(--color-line-light); }
  :global(.menu-open) .lang a { color: var(--color-cream); }
  :global(.menu-open) .lang a[aria-current="true"] { background: var(--color-matcha); color: var(--color-forest); }
  :global(.menu-open) .site-header { background: transparent; box-shadow: none; backdrop-filter: none; translate: 0 0; }
  .mobile-menu { clip-path: inset(0 0 100% 0); transition: clip-path .7s var(--ease-in-out-quart); }
  .mobile-menu.is-open { clip-path: inset(0 0 0 0); }
</style>
