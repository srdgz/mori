{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 4600",
      "startServerReadyPattern": "Ready",
      "numberOfRuns": 5,
      "url": [
        "http://localhost:4600/",
        "http://localhost:4600/carta",
        "http://localhost:4600/carta/classic-matcha",
        "http://localhost:4600/historia",
        "http://localhost:4600/cultura-matcha",
        "http://localhost:4600/donde-estamos",
        "http://localhost:4600/contacto",
        "http://localhost:4600/privacidad",
        "http://localhost:4600/en/menu"
      ],
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 270000 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
