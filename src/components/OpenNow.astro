---
import { useT, brand, type Lang } from "../i18n/ui";
interface Props { lang: Lang; tone?: "dark" | "light" }
const { lang, tone = "dark" } = Astro.props;
const t = useT(lang);
---
<p
  class:list={["open-now mt-5 inline-flex items-center gap-2.5 rounded-full px-3.5 py-2 text-sm font-medium", tone === "light" && "is-light"]}
  data-open-now
  data-weekday={brand.hours.weekday.join("-")}
  data-weekend={brand.hours.weekend.join("-")}
  data-open-until={t("openUntil")}
  data-closed-opens-at={t("closedOpensAt")}
  data-closed-tomorrow={t("closedTomorrow")}
  hidden
>
  <span class="dot size-2 rounded-full bg-current" aria-hidden="true"></span>
  <span data-open-text></span>
</p>

<style>
  .open-now { background: rgb(182 214 107 / 0.14); color: var(--color-matcha); }
  .open-now .dot { animation: pulse-dot 2s ease-in-out infinite; }
  .open-now.is-closed { background: rgb(232 225 212 / 0.1); color: var(--color-cream); }
  .open-now.is-closed .dot { animation: none; opacity: .5; }
  .open-now.is-light { background: rgb(24 61 43 / 0.08); color: var(--color-forest); }
  .open-now.is-light.is-closed { color: var(--color-ink-soft); }
</style>
